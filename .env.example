# Optional legacy/provider key. Model 2 does not call Groq unless configured below.
GROQ_API_KEY=

# JSON array of OpenAI-compatible chat-completions providers for Model 2.
# Use api_key_env to keep secrets out of this file.
FLAW_MODEL_ENDPOINTS=[
  {"name":"glm","url":"https://api.z.ai/api/paas/v4/chat/completions","model":"glm-4.5","api_key_env":"ZAI_API_KEY"},
  {"name":"openrouter","url":"https://openrouter.ai/api/v1/chat/completions","model":"anthropic/claude-sonnet-4","api_key_env":"OPENROUTER_API_KEY"}
]

# Keys referenced by the provider entries above.
ZAI_API_KEY=
OPENROUTER_API_KEY=

# Model 1 workflow understanding. Configure one or more OpenAI-compatible
# endpoints to use actual LLM outputs for arbitrary requirements.
WORKFLOW_REQUIRE_API=false
WORKFLOW_MODEL_ENDPOINTS=[]
GEMINI_MODEL=gemini-2.0-flash
MINIMAX_MODEL=MiniMax-Text-01

# Optional Model 5 router gateway. Leave blank for local routing with no key.
# LiteLLM, OmniRoute, ClawRouter, ClawRouters, RouteLLM, and LLMRouter can expose
# an OpenAI-compatible endpoint. The endpoint must return chosen_model or model.
MODEL_ROUTER_ENDPOINT=
MODEL_ROUTER_API_KEY=

# Optional Model 6 trained risk model and LLM risk-analysis providers.
# RISK_MODEL_PATH should point to a joblib model exposing predict_proba().
RISK_MODEL_PATH=
RISK_MODEL_ENDPOINTS=[]
